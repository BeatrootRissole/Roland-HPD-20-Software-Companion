<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-platform command line build of the HPD-20 tooling.

    The GUI (src/HPD20Ctrl.cs and friends) is WinForms plus winmm and only builds on Windows.
    Everything the CLI needs is plain C#, apart from Media Foundation decoding, which is compiled
    in on Windows only.

    Build and run:
        dotnet run --project cli -- info mysample.flac
        dotnet publish cli -c Release -r linux-x64 --self-contained false

    Target framework: net8.0 (LTS). If your SDK is newer and you do not have the .NET 8 targeting
    pack, change TargetFramework to net9.0 / net10.0 to match.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>hpd20cli</AssemblyName>
    <RootNamespace>Hpd20Ctrl</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DefineConstants Condition="'$(OS)' == 'Windows_NT'">$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\BackupFile.cs" />
    <Compile Include="..\src\WavFile.cs" />
    <Compile Include="..\src\AudioFormats.cs" />
    <Compile Include="..\src\InstrumentTable.cs" />
    <Compile Include="..\src\WaveEditor.cs" />
    <Compile Include="..\tests\BackupDiff.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Compile Include="..\src\MfAudio.cs" />
  </ItemGroup>

</Project>
